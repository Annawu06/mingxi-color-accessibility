{
  "manifest_version": 3,
  "name": "明晰 · 色彩友好浏览",
  "version": "0.1.0",
  "description": "为色盲与色弱用户优化网页色彩和对比度。",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "明晰：调整色彩体验",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-mingxi": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Command+Shift+S" },
      "description": "开关明晰色彩友好模式"
    },
    "open-mingxi-reader": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Command+Shift+R" },
      "description": "打开明晰沉浸式阅读模式"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
